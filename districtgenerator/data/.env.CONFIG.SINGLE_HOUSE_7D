# Minimal config for a single-house 7-day demand sweep.
# Only the parameters that differ from the defaults are defined here.

SCENARIO_NAME=single_house_7d

# Location and weather
ZIP=10115
TRYYEAR=TRY2015
TRYTYPE=Jahr

# Time settings: 7 days with 10-minute resolution
TIMERESOLUTION=600
DATARESOLUTION=3600
DATALENGTH=604800
CLUSTERLENGTH=604800

# Building thermal model
THERMAL_MODEL_TYPE=7R2C
